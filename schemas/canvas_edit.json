{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Diagram name."
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object"
      },
      "description": "Ops: add, update, move, delete, or clear. One call per change set."
    }
  },
  "required": ["name", "ops"],
  "additionalProperties": false
}
