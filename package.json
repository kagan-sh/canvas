{
  "name": "kagan-plugin-canvas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A drawing canvas in the thread's side panel. You draw, agents draw, and you send what you see to any thread.",
  "scripts": {
    "build": "npm run build:main && npm run build:ui",
    "build:main": "esbuild src/main.ts --bundle --format=esm --target=es2022 --external:kagan/* --external:gpui-kit --external:gpui-shell --outfile=main.js",
    "build:ui": "esbuild src/ui/main.tsx --bundle --format=iife --target=es2022 --jsx=automatic --minify --outfile=ui/app.js && tailwindcss -i src/ui/app.css -o ui/app.css --minify",
    "typecheck": "tsc -p .",
    "test": "node --import ./test/register-tsx.mjs --test src/*.test.ts src/host/*.test.ts src/ui/*.test.ts src/fonts/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:ui": "npm run build && node test/ui/canvas-page.mjs",
    "check:ui": "npm run check && npm run test:ui"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "roughjs": "^4.6.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
